@model List<Appointment>
@{ ViewData["Title"] = "My Appointments"; }
<h2 class="mb-3">My Appointments</h2>
@if (!Model.Any())
{
    <div class="alert alert-info">You have no appointments yet. <a asp-controller="Doctors" asp-action="Index">Find a doctor</a>.</div>
}
else
{
<div class="table-responsive">
<table class="table table-striped bg-white align-middle">
    <thead><tr><th>Doctor</th><th>Date</th><th>Time</th><th>Reason</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var a in Model)
    {
        var badge = a.Status switch {
            AppointmentStatus.Confirmed => "bg-success",
            AppointmentStatus.Completed => "bg-secondary",
            AppointmentStatus.Cancelled => "bg-danger",
            _ => "bg-warning text-dark" };
        <tr>
            <td>@a.Doctor?.FullName<br /><small class="text-muted">@a.Doctor?.Specialty?.Name</small></td>
            <td>@a.StartTime.ToString("ddd, dd MMM yyyy")</td>
            <td>@a.StartTime.ToString("hh:mm tt") - @a.EndTime.ToString("hh:mm tt")</td>
            <td>@a.Reason</td>
            <td><span class="badge @badge">@a.Status</span></td>
            <td>
            @if ((a.Status == AppointmentStatus.Pending || a.Status == AppointmentStatus.Confirmed) && a.StartTime > DateTime.Now)
            {
                <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this appointment?');">
                    <input type="hidden" name="id" value="@a.Id" />
                    <button class="btn btn-sm btn-outline-danger">Cancel</button>
                </form>
            }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
}
