@{ ViewData["Title"] = "Home"; }
<div class="p-5 mb-4 bg-white rounded-3 shadow-sm text-center">
    <h1 class="display-5 fw-bold">Book your doctor in under a minute</h1>
    <p class="lead text-muted">Pick a specialist, choose a free time slot, and get confirmed by the clinic.</p>
    <a class="btn btn-primary btn-lg" asp-controller="Doctors" asp-action="Index">Find a Doctor</a>
</div>
<div class="row text-center g-3">
    <div class="col-md-4"><div class="card h-100 p-3"><h5>Real-time slots</h5><p class="text-muted mb-0">Only free times are shown, so double bookings are impossible.</p></div></div>
    <div class="col-md-4"><div class="card h-100 p-3"><h5>Manage appointments</h5><p class="text-muted mb-0">View and cancel your bookings from one place.</p></div></div>
    <div class="col-md-4"><div class="card h-100 p-3"><h5>Admin dashboard</h5><p class="text-muted mb-0">Clinic staff confirm, complete and track visits.</p></div></div>
</div>
