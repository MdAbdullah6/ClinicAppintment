@model AdminDashboardViewModel
@{ ViewData["Title"] = "Admin Dashboard"; }
<h2 class="mb-4">Admin Dashboard</h2>
<div class="row g-3 mb-4 text-center">
    <div class="col-6 col-md-3"><div class="card p-3"><div class="fs-2">@Model.TotalAppointments</div>Total</div></div>
    <div class="col-6 col-md-3"><div class="card p-3"><div class="fs-2">@Model.TodayAppointments</div>Today</div></div>
    <div class="col-6 col-md-3"><div class="card p-3"><div class="fs-2">@Model.PendingAppointments</div>Pending</div></div>
    <div class="col-6 col-md-3"><div class="card p-3"><div class="fs-2">@Model.DoctorCount</div>Doctors</div></div>
</div>
<h5>Upcoming appointments</h5>
<div class="table-responsive">
<table class="table table-striped bg-white align-middle">
    <thead><tr><th>#</th><th>Patient</th><th>Doctor</th><th>When</th><th>Status</th><th>Update</th></tr></thead>
    <tbody>
    @foreach (var a in Model.Appointments)
    {
        <tr>
            <td>@a.Id</td>
            <td>@(a.Patient?.FullName ?? a.Patient?.Email)</td>
            <td>@a.Doctor?.FullName</td>
            <td>@a.StartTime.ToString("dd MMM, hh:mm tt")</td>
            <td>@a.Status</td>
            <td>
                <form asp-action="SetStatus" method="post" class="d-flex gap-1">
                    <input type="hidden" name="id" value="@a.Id" />
                    <select name="status" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<AppointmentStatus>()"></select>
                    <button class="btn btn-sm btn-primary">Save</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
